# Copy to .env and fill in. Never commit .env.
# TMDB (free key: https://www.themoviedb.org/settings/api). Without it the app
# falls back to MovieLens-only and posters/cast/trailers are degraded.
TMDB_API_KEY=
# Optional: enables Claude-based query parsing + explanation sentences.
ANTHROPIC_API_KEY=
# Auth signing secret — change in production!
JWT_SECRET=dev-only-change-me
# Defaults use SQLite locally so the suite runs without services.
# Docker compose overrides with postgres/redis.
DATABASE_URL=sqlite:///./cinematch.db
REDIS_URL=redis://localhost:6379/0
# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_TMDB_KEY=
